{
  "name": "ci-comunicacao-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@testing-library/dom": "^10.4.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
